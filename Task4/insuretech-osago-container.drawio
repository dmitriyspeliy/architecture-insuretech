        </mxCell>
        <mxCell id="core" value="&lt;b&gt;core-app&lt;/b&gt;&lt;br/&gt;[Kotlin, Spring Boot]&lt;br/&gt;&lt;br/&gt;Оформление ОСАГО, REST API для создания заявки, SSE stream предложений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="430" y="220" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="coredb" value="&lt;b&gt;core-db&lt;/b&gt;&lt;br/&gt;[PostgreSQL]&lt;br/&gt;&lt;br/&gt;Заявки ОСАГО, офферы, статус расчёта, outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="440" y="470" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="core_outbox" value="&lt;b&gt;Transactional Outbox&lt;/b&gt;&lt;br/&gt;core-app публикует OsagoApplicationCreated после commit заявки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;align=left;verticalAlign=top;fontSize=11;spacing=8;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="430" y="650" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="&lt;b&gt;Event Broker&lt;/b&gt;&lt;br/&gt;[Kafka / Event Streaming]&lt;br/&gt;&lt;br/&gt;topics:&lt;br/&gt;osago.application.created&lt;br/&gt;osago.offer.received&lt;br/&gt;osago.quote.completed&lt;br/&gt;osago.quote.timed_out" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2C94C;strokeColor=#B58B00;fontColor=#111111;align=center;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="800" y="270" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="agg" value="&lt;b&gt;osago-aggregator&lt;/b&gt;&lt;br/&gt;[Kotlin, Spring Boot]&lt;br/&gt;&lt;br/&gt;Принимает события заявок, отправляет заявки в страховые, опрашивает решения до 60 сек." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="1180" y="200" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="aggdb" value="&lt;b&gt;osago-aggregator-db&lt;/b&gt;&lt;br/&gt;[PostgreSQL]&lt;br/&gt;&lt;br/&gt;CorrelationId, insurer request id, статус по каждой СК, дедлайны, попытки polling, outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1180" y="500" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="agg_outbox" value="&lt;b&gt;Transactional Outbox&lt;/b&gt;&lt;br/&gt;osago-aggregator публикует каждый полученный оффер и финальный статус надёжно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;align=left;verticalAlign=top;fontSize=11;spacing=8;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="1180" y="660" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="insurers" value="&lt;b&gt;Системы страховых компаний&lt;/b&gt;&lt;br/&gt;[REST API]&lt;br/&gt;&lt;br/&gt;1) создать заявку ОСАГО&lt;br/&gt;2) получить предложение по заявке&lt;br/&gt;&lt;br/&gt;Сейчас 5 СК, целевое расширение до 10+" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" parent="1" vertex="1">
