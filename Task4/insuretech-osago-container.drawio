        </mxCell>
        <mxCell id="product" value="&lt;b&gt;ins-product-aggregator&lt;/b&gt;&lt;br/&gt;[Kotlin, Spring Boot]&lt;br/&gt;&lt;br/&gt;Продукты и тарифы через event streaming из Task3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" parent="1" vertex="1">
