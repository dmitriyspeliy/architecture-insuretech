        <mxCell id="web" value="&lt;b&gt;InsureTech Web&lt;/b&gt;&lt;br/&gt;[React]&lt;br/&gt;&lt;br/&gt;Форма ОСАГО, отображение предложений по мере поступления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" parent="1" vertex="1">
